    signal mixsum_64_2_1;
    mixsum_64_2_1 <== mix_64_2_0 + mix_64_2_1;
    signal mixsum_64_2_2;
    mixsum_64_2_2 <== mixsum_64_2_1 + mix_64_2_2;
    signal state_65_2;
    state_65_2 <== mixsum_64_2_2;

    out[0] <== state_65_1;
}

template PoseidonEx(nInputs, nOuts) {
    signal input inputs[nInputs];
    signal input initialState;
    signal output out[nOuts];

    assert(nOuts == 1);
    assert(nInputs > 0);

    if (nInputs == 1) {
        component p1 = PoseidonEx1_1();
        p1.initialState <== initialState;
        p1.inputs[0] <== inputs[0];
        out[0] <== p1.out[0];
    } else if (nInputs == 2) {
        component p2 = PoseidonEx2_1();
        p2.initialState <== initialState;
        p2.inputs[0] <== inputs[0];
        p2.inputs[1] <== inputs[1];
        out[0] <== p2.out[0];
    } else {
        component prefix = PoseidonEx(nInputs - 1, 1);
        prefix.initialState <== initialState;
        for (var i = 0; i < nInputs - 1; i++) {
            prefix.inputs[i] <== inputs[i];
        }

        component tail = PoseidonEx(1, 1);
        tail.initialState <== prefix.out[0];
        tail.inputs[0] <== inputs[nInputs - 1];
        out[0] <== tail.out[0];
    }
}

template Poseidon(nInputs) {
    signal input inputs[nInputs];
    signal output out;

    component pEx = PoseidonEx(nInputs, 1);
    pEx.initialState <== 0;
    for (var i = 0; i < nInputs; i++) {
        pEx.inputs[i] <== inputs[i];
    }
    out <== pEx.out[0];
}
