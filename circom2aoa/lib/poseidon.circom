    signal rc_64_2;
    rc_64_2 <== 4588471704252117275229402798387406581178620422287828240903508445206299828288;

    signal ark_64_0;
    ark_64_0 <== state_64_0 + rc_64_0;
    signal ark_64_1;
    ark_64_1 <== state_64_1 + rc_64_1;
    signal ark_64_2;
    ark_64_2 <== state_64_2 + rc_64_2;

    component sbox_64_0 = Sigma();
    sbox_64_0.in <== ark_64_0;
    component sbox_64_1 = Sigma();
    sbox_64_1.in <== ark_64_1;
