    signal mixsum_63_0_1;
    mixsum_63_0_1 <== mix_63_0_0 + mix_63_0_1;
    signal mixsum_63_0_2;
    mixsum_63_0_2 <== mixsum_63_0_1 + mix_63_0_2;
    signal state_64_0;
    state_64_0 <== mixsum_63_0_2;
    signal mixsum_63_1_1;
    mixsum_63_1_1 <== mix_63_1_0 + mix_63_1_1;
    signal mixsum_63_1_2;
    mixsum_63_1_2 <== mixsum_63_1_1 + mix_63_1_2;
    signal state_64_1;
    state_64_1 <== mixsum_63_1_2;
    signal mixsum_63_2_1;
    mixsum_63_2_1 <== mix_63_2_0 + mix_63_2_1;
    signal mixsum_63_2_2;
    mixsum_63_2_2 <== mixsum_63_2_1 + mix_63_2_2;
    signal state_64_2;
    state_64_2 <== mixsum_63_2_2;

    // === Round 64 (full) ===
    signal rc_64_0;
    rc_64_0 <== 18212744127148706991576351881177392918442108094234386512915740752668906685687;
    signal rc_64_1;
