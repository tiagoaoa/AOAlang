#!/bin/sh
#
# Configure script for AOAlang
# Checks for required dependencies and sets up build environment
#

set -e

echo "Configuring AOAlang..."
echo ""

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check for required tools
check_tool() {
    tool=$1
    package=$2

    if command -v $tool >/dev/null 2>&1; then
        version=$($tool --version 2>&1 | head -n 1)
        echo "${GREEN}✓${NC} Found $tool: $version"
        return 0
    else
        echo "${RED}✗${NC} Missing $tool"
        echo "   Install with: $package"
        return 1
    fi
}

echo "Checking for required tools..."
echo ""

missing=0

# Check for C compiler
if ! check_tool gcc "apt-get install gcc / brew install gcc / dnf install gcc"; then
    missing=$((missing + 1))
fi

# Check for make
if ! check_tool make "apt-get install make / brew install make / dnf install make"; then
    missing=$((missing + 1))
fi

# Check for flex (lex)
if ! check_tool flex "apt-get install flex / brew install flex / dnf install flex"; then
    missing=$((missing + 1))
fi

# Check for bison (yacc)
if ! check_tool bison "apt-get install bison / brew install bison / dnf install bison"; then
    missing=$((missing + 1))
fi

echo ""

if [ $missing -gt 0 ]; then
    echo "${RED}Configuration failed: $missing required tool(s) missing${NC}"
    echo ""
    echo "Install missing dependencies and run ./configure again"
    exit 1
fi

# Create directories if they don't exist
echo "Creating directories..."
mkdir -p bin
echo "${GREEN}✓${NC} Created bin/"

if [ ! -d examples ]; then
    echo "${YELLOW}⚠${NC}  No examples/ directory - create it and add .aoa files"
fi

echo ""
echo "${GREEN}✓ Configuration successful!${NC}"
echo ""
echo "Build with:    make"
echo "Test with:     make test"
echo "Install with:  sudo make install"
echo ""
