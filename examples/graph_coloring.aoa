# Graph Coloring ZK Proof
#
# Proves knowledge of a coloring where no two adjacent vertices
# share the same color, without revealing the coloring itself.
#
# Graph (5 vertices, 6 edges):
#
#     0
#    / \
#   1---2
#   |   |
#   3---4
#
# Edges: (0,1) (0,2) (1,2) (1,3) (2,4) (3,4)
#
# Private witness: c[0..4] color assignments
#                  inv     inverse of product of edge differences
#
# Strategy: compute d[e] = c[u] - c[v] for each edge, multiply all
# differences together, and prove the product is non-zero via
# p * inv == 1. If any edge has equal colors, the product is 0
# and no inv can satisfy 0 * inv == 1.

decl private c[5]
decl private inv

# ============ EDGE DIFFERENCES ============

d0 = c[0] - c[1]
d1 = c[0] - c[2]
d2 = c[1] - c[2]
d3 = c[1] - c[3]
d4 = c[2] - c[4]
d5 = c[3] - c[4]

# ============ CHAIN PRODUCT ============

p1 = d0 * d1
p2 = p1 * d2
p3 = p2 * d3
p4 = p3 * d4
p5 = p4 * d5

# ============ NON-ZERO CHECK ============
# p5 * inv == 1 proves all edges have different colors

one = 1
prod = p5 * inv
chk = prod == one
