diff2 = sum_2_final - prod2_2_final
not_a2 = 1 - a[2]
term1_2 = not_a2 * b[2]
equal_2 = 1 - xor_2_ab
term2_2 = equal_2 * borrow1
or_sum_2 = term1_2 + term2_2
or_prod_2 = term1_2 * term2_2
or_prod2_2 = or_prod_2 + or_prod_2
borrow2 = or_sum_2 - or_prod2_2

