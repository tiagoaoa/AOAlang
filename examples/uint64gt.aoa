# 64-bit unsigned integer greater-than comparison
# Compares if a > b where a and b are 64-bit unsigned integers
# Implemented as subtraction a - b, checking if there's NO borrow
# a > b iff a - b doesn't underflow (no final borrow)

decl private a[64]
decl deferred b[64]
decl deferred result

# Bit 0 subtraction: a[0] - b[0]
diff0 = a[0] - b[0]
not_a0 = 1 - a[0]
borrow0 = not_a0 * b[0]

# Bit 1 subtraction
sum_1_ab = a[1] + b[1]
prod_1_ab = a[1] * b[1]
prod2_1_ab = prod_1_ab + prod_1_ab
xor_1_ab = sum_1_ab - prod2_1_ab
sum_1_final = xor_1_ab + borrow0
prod_1_final = xor_1_ab * borrow0
prod2_1_final = prod_1_final + prod_1_final
diff1 = sum_1_final - prod2_1_final
not_a1 = 1 - a[1]
term1_1 = not_a1 * b[1]
equal_1 = 1 - xor_1_ab
term2_1 = equal_1 * borrow0
or_sum_1 = term1_1 + term2_1
or_prod_1 = term1_1 * term2_1
or_prod2_1 = or_prod_1 + or_prod_1
borrow1 = or_sum_1 - or_prod2_1

