decl private u[1]
decl deferred a[2], b[2]

# a_val = a[0] + 2*a[1]  (0-3)
two_a1 = a[1] + a[1]
a_val = a[0] + two_a1

# b_val = b[0] + 2*b[1]  (0-3)
two_b1 = b[1] + b[1]
b_val = b[0] + two_b1

# Compute u^2
u_squared = u[0] * u[0]

# Compute a*u
au = a_val * u[0]

# Compute u^2 + a*u + b
sum1 = u_squared + au
poly_result = sum1 + b_val

# Enforce poly_result == 0
zero_const = 0
check = poly_result == zero_const
