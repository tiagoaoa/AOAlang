# Bitwise Greater-Equal: u >= t (8-bit unsigned comparison)
#
# Private:  u[8] - 8-bit secret value
# Deferred: t[8] - 8-bit symbolic threshold
#
# Proves u >= t by computing subtraction with borrow chain.
# Only asserts: borrow[7] == 0 (no underflow means u >= t)
#
# Bitwise ops in R1CS:
#   XOR(a,b) = a + b - 2*a*b
#   AND(a,b) = a * b
#   NOT(a)   = 1 - a
#   OR(a,b)  = a + b - a*b

decl private u[8]
decl deferred t[8]

# ============ BOOLEAN CONSTRAINTS (inputs only) ============
u0_sq = u[0] * u[0]
u0_bit = u0_sq - u[0]
u1_sq = u[1] * u[1]
u1_bit = u1_sq - u[1]
u2_sq = u[2] * u[2]
u2_bit = u2_sq - u[2]
u3_sq = u[3] * u[3]
u3_bit = u3_sq - u[3]
u4_sq = u[4] * u[4]
u4_bit = u4_sq - u[4]
u5_sq = u[5] * u[5]
u5_bit = u5_sq - u[5]
u6_sq = u[6] * u[6]
u6_bit = u6_sq - u[6]
u7_sq = u[7] * u[7]
u7_bit = u7_sq - u[7]

# ============ BIT 0: HALF SUBTRACTOR ============
# borrow[0] = !u[0] & t[0] = (1 - u[0]) * t[0]
not_u0 = 1 - u[0]
bw0 = not_u0 * t[0]

# ============ BIT 1: FULL SUBTRACTOR ============
# borrow[1] = (!u[1] & t[1]) | (!u[1] & bw0) | (t[1] & bw0)
not_u1 = 1 - u[1]
and1_a = not_u1 * t[1]
and1_b = not_u1 * bw0
and1_c = t[1] * bw0
or1_ab = and1_a + and1_b
and1_ab = and1_a * and1_b
or1_ab_v = or1_ab - and1_ab
or1_abc = or1_ab_v + and1_c
and1_abc = or1_ab_v * and1_c
bw1 = or1_abc - and1_abc

# ============ BIT 2: FULL SUBTRACTOR ============
not_u2 = 1 - u[2]
and2_a = not_u2 * t[2]
and2_b = not_u2 * bw1
and2_c = t[2] * bw1
or2_ab = and2_a + and2_b
and2_ab = and2_a * and2_b
or2_ab_v = or2_ab - and2_ab
or2_abc = or2_ab_v + and2_c
and2_abc = or2_ab_v * and2_c
bw2 = or2_abc - and2_abc

# ============ BIT 3: FULL SUBTRACTOR ============
not_u3 = 1 - u[3]
and3_a = not_u3 * t[3]
and3_b = not_u3 * bw2
and3_c = t[3] * bw2
or3_ab = and3_a + and3_b
and3_ab = and3_a * and3_b
or3_ab_v = or3_ab - and3_ab
or3_abc = or3_ab_v + and3_c
and3_abc = or3_ab_v * and3_c
bw3 = or3_abc - and3_abc

# ============ BIT 4: FULL SUBTRACTOR ============
not_u4 = 1 - u[4]
and4_a = not_u4 * t[4]
and4_b = not_u4 * bw3
and4_c = t[4] * bw3
or4_ab = and4_a + and4_b
and4_ab = and4_a * and4_b
or4_ab_v = or4_ab - and4_ab
or4_abc = or4_ab_v + and4_c
and4_abc = or4_ab_v * and4_c
bw4 = or4_abc - and4_abc

# ============ BIT 5: FULL SUBTRACTOR ============
not_u5 = 1 - u[5]
and5_a = not_u5 * t[5]
and5_b = not_u5 * bw4
and5_c = t[5] * bw4
or5_ab = and5_a + and5_b
and5_ab = and5_a * and5_b
or5_ab_v = or5_ab - and5_ab
or5_abc = or5_ab_v + and5_c
and5_abc = or5_ab_v * and5_c
bw5 = or5_abc - and5_abc

# ============ BIT 6: FULL SUBTRACTOR ============
not_u6 = 1 - u[6]
and6_a = not_u6 * t[6]
and6_b = not_u6 * bw5
and6_c = t[6] * bw5
or6_ab = and6_a + and6_b
and6_ab = and6_a * and6_b
or6_ab_v = or6_ab - and6_ab
or6_abc = or6_ab_v + and6_c
and6_abc = or6_ab_v * and6_c
bw6 = or6_abc - and6_abc

# ============ BIT 7: FULL SUBTRACTOR (MSB) ============
not_u7 = 1 - u[7]
and7_a = not_u7 * t[7]
and7_b = not_u7 * bw6
and7_c = t[7] * bw6
or7_ab = and7_a + and7_b
and7_ab = and7_a * and7_b
or7_ab_v = or7_ab - and7_ab
or7_abc = or7_ab_v + and7_c
and7_abc = or7_ab_v * and7_c
bw7 = or7_abc - and7_abc

# ============ SINGLE ASSERTION: SIGN BIT ============
# bw7 = 0 means no underflow, i.e., u >= t
zero = 0
sign_check = bw7 == zero
