# 64-bit unsigned integer greater-than-or-equal comparison using range proof
# Proves: actual >= minOut (i.e., actual - minOut fits in 64 bits)
#
# AMM use case:
# - actual: public on-chain execution result (e.g., swap output amount)
# - minOut: prover's private minimum acceptable value (secret slippage tolerance)
#
# Approach: Instead of borrow-tracking subtraction, prove that diff = actual - minOut
# can be decomposed into 64 bits (meaning diff >= 0 in unsigned interpretation).
#
# If actual < minOut, the field subtraction wraps to a huge number (~2^254)
# which cannot be represented in 64 bits, causing the proof to fail.
#
# Constraints: ~129 (vs ~317 for borrow-tracking approach)
# - 1: diff computation
# - 64: Horner reconstruction (doubling + addition)
# - 64: binary checks (d[i] * d[i] = d[i])

decl deferred actual
decl private d[64]
decl private minOut

# Compute difference (field subtraction)
diff = actual - minOut

# Horner reconstruction: r = d[63]*2^63 + d[62]*2^62 + ... + d[0]
# Evaluated as: (((...((d[63])*2 + d[62])*2 + d[61])*2 + ...)*2 + d[0])
# Each iteration: r_i = 2 * r_{i+1} + d[i] = r_{i+1} + r_{i+1} + d[i]

r63 = d[63]

r62_dbl = r63 + r63
r62 = r62_dbl + d[62]

r61_dbl = r62 + r62
r61 = r61_dbl + d[61]

r60_dbl = r61 + r61
r60 = r60_dbl + d[60]

r59_dbl = r60 + r60
r59 = r59_dbl + d[59]

r58_dbl = r59 + r59
r58 = r58_dbl + d[58]

r57_dbl = r58 + r58
r57 = r57_dbl + d[57]

r56_dbl = r57 + r57
r56 = r56_dbl + d[56]

r55_dbl = r56 + r56
r55 = r55_dbl + d[55]

r54_dbl = r55 + r55
r54 = r54_dbl + d[54]

r53_dbl = r54 + r54
r53 = r53_dbl + d[53]

r52_dbl = r53 + r53
r52 = r52_dbl + d[52]

r51_dbl = r52 + r52
r51 = r51_dbl + d[51]

r50_dbl = r51 + r51
r50 = r50_dbl + d[50]

r49_dbl = r50 + r50
r49 = r49_dbl + d[49]

r48_dbl = r49 + r49
r48 = r48_dbl + d[48]

r47_dbl = r48 + r48
r47 = r47_dbl + d[47]

r46_dbl = r47 + r47
r46 = r46_dbl + d[46]

r45_dbl = r46 + r46
r45 = r45_dbl + d[45]

r44_dbl = r45 + r45
r44 = r44_dbl + d[44]

r43_dbl = r44 + r44
r43 = r43_dbl + d[43]

r42_dbl = r43 + r43
r42 = r42_dbl + d[42]

r41_dbl = r42 + r42
r41 = r41_dbl + d[41]

r40_dbl = r41 + r41
r40 = r40_dbl + d[40]

r39_dbl = r40 + r40
r39 = r39_dbl + d[39]

r38_dbl = r39 + r39
r38 = r38_dbl + d[38]

r37_dbl = r38 + r38
r37 = r37_dbl + d[37]

r36_dbl = r37 + r37
r36 = r36_dbl + d[36]

