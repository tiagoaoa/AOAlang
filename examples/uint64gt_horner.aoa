r23 = r23_dbl + d[23]

r22_dbl = r23 + r23
r22 = r22_dbl + d[22]

r21_dbl = r22 + r22
r21 = r21_dbl + d[21]

r20_dbl = r21 + r21
r20 = r20_dbl + d[20]

r19_dbl = r20 + r20
r19 = r19_dbl + d[19]

r18_dbl = r19 + r19
r18 = r18_dbl + d[18]

r17_dbl = r18 + r18
r17 = r17_dbl + d[17]

r16_dbl = r17 + r17
r16 = r16_dbl + d[16]

r15_dbl = r16 + r16
r15 = r15_dbl + d[15]

