r14 = r14_dbl + d[14]

r13_dbl = r14 + r14
r13 = r13_dbl + d[13]

r12_dbl = r13 + r13
r12 = r12_dbl + d[12]

r11_dbl = r12 + r12
r11 = r11_dbl + d[11]

r10_dbl = r11 + r11
r10 = r10_dbl + d[10]

r9_dbl = r10 + r10
r9 = r9_dbl + d[9]

r8_dbl = r9 + r9
r8 = r8_dbl + d[8]

r7_dbl = r8 + r8
r7 = r7_dbl + d[7]

r6_dbl = r7 + r7
r6 = r6_dbl + d[6]

r5_dbl = r6 + r6
r5 = r5_dbl + d[5]

r4_dbl = r5 + r5
r4 = r4_dbl + d[4]

r3_dbl = r4 + r4
r3 = r3_dbl + d[3]

r2_dbl = r3 + r3
r2 = r2_dbl + d[2]

r1_dbl = r2 + r2
r1 = r1_dbl + d[1]

r0_dbl = r1 + r1
reconstructed = r0_dbl + d[0]

# Verify reconstruction equals diff
check_val = reconstructed - diff
zero = 0
verify_recon = check_val == zero

# Binary checks: d[i] * (d[i] - 1) = 0 for all i
# Each bit requires 3 constraints:
#   1. d_m = d[i] - 1
#   2. c = d[i] * d_m
#   3. v = c == zero
one = 1

d63m = d[63] - one
c63 = d[63] * d63m
v63 = c63 == zero

d62m = d[62] - one
c62 = d[62] * d62m
v62 = c62 == zero

d61m = d[61] - one
c61 = d[61] * d61m
v61 = c61 == zero

d60m = d[60] - one
c60 = d[60] * d60m
v60 = c60 == zero

