r34 = r34_dbl + d[34]

r33_dbl = r34 + r34
r33 = r33_dbl + d[33]

r32_dbl = r33 + r33
r32 = r32_dbl + d[32]

r31_dbl = r32 + r32
r31 = r31_dbl + d[31]

r30_dbl = r31 + r31
r30 = r30_dbl + d[30]

