# Vitalik's QAP example with symbolic k
# Original: u^3 + u + 5 = 35 (where u=3)
# Modified: u^3 + u + k = 35 (k is symbolic/deferred)

decl private u
decl deferred k

# Flatten u^3
sym_1 = u * u
y = sym_1 * u

# Compute u^3 + u
sym_2 = y + u

# Compute u^3 + u + k
out = sym_2 + k

# Enforce out == 35
thirty_five = 35
check = out == thirty_five
