# This is a meta language used only here (so far). I can see this being code generated by a compiler for a high level language.
decl private a[4]
decl deferred b[4]

# Bit 0 - a[0] xor b[0]: a[0] + b[0] - 2*a[0]*b[0]
sym1 = a[0] + b[0]           # First part of XOR
sym2 = a[0] * b[0]           # AND operation for carry and XOR
sym3 = sym2 + sym2           # Double the AND result
sum_bit0 = sym1 - sym3       # Complete XOR: a[0] XOR b[0]

# Bit 1 - a[1] xor b[1]
sym4 = a[1] + b[1]           # First part of XOR
sym5 = a[1] * b[1]           # AND for carry generation and XOR
sym6 = sym5 + sym5           # Double the AND result
xor1_temp = sym4 - sym6      # a[1] XOR b[1]

# Bit 1 - Second XOR: (a[1] XOR b[1]) XOR carrybit0
sym7 = xor1_temp + sym2      # First part of second XOR
sym8 = xor1_temp * sym2      # AND for second XOR
sym9 = sym8 + sym8           # Double the AND result
sum_bit1 = sym7 - sym9       # Final bit 1 result

# Bit 1 - Carry generation: (a[1] AND b[1]) OR (carrybit0 AND (a[1] XOR b[1]))
sym10 = sym2 * xor1_temp     # carrybit0 AND (a[1] XOR b[1])
sym11 = sym5 + sym10         # OR operation part 1
sym12 = sym5 * sym10         # AND for OR correction
sym13 = sym12 + sym12        # Double for OR correction
carry_bit1 = sym11 - sym13   # Complete OR: carry from bit 1

# Bit 2 - First XOR: a[2] XOR b[2]
sym14 = a[2] + b[2]          # First part of XOR
sym15 = a[2] * b[2]          # AND for carry generation and XOR
sym16 = sym15 + sym15        # Double the AND result
xor2_temp = sym14 - sym16    # a[2] XOR b[2]

# Bit 2 - Second XOR: (a[2] XOR b[2]) XOR carrybit1
sym17 = xor2_temp + carry_bit1      # First part of second XOR
sym18 = xor2_temp * carry_bit1      # AND for second XOR
sym19 = sym18 + sym18               # Double the AND result
sum_bit2 = sym17 - sym19            # Final bit 2 result

# Bit 2 - Carry out generation: (a[2] AND b[2]) OR (carrybit1 AND (a[2] XOR b[2]))
sym20 = carry_bit1 * xor2_temp      # carrybit1 AND (a[2] XOR b[2])
sym21 = sym15 + sym20               # OR operation part 1
sym22 = sym15 * sym20               # AND for OR correction
sym23 = sym22 + sym22               # Double for OR correction
actual_carry_out = sym21 - sym23    # Complete OR: final carry out

# FIXED: Create a constraint that compares actual vs claimed carry out
claimed_carry = 0                   # The hardcoded claim
carry_check = actual_carry_out == claimed_carry     # Enforce the equality constraint
